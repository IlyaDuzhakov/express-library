<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Редактировать книгу</title>
</head>
<body>

  <h1>Редактировать книгу</h1>

  <form action="/books/<%= book.id %>/update" method="POST">

    <div>
      <label>
        Название:
        <input type="text" name="title" value="<%= book.title %>" required>
      </label>
    </div>

    <div>
      <label>
        Автор:
        <input type="text" name="author" value="<%= book.author %>" required>
      </label>
    </div>

    <div>
      <label>
        Избранное:
        <select name="favorite">
          <option value="false" <%= !book.favorite ? "selected" : "" %>>
            Нет
          </option>

          <option value="true" <%= book.favorite ? "selected" : "" %>>
            Да
          </option>
        </select>
      </label>
    </div>

    <button type="submit">Сохранить</button>

  </form>

  <a href="/books/<%= book.id %>">Назад к книге</a>

</body>
</html>